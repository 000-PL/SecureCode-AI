# ---- Database -------------------------------------------------------------
# Default (works out of the box, no install needed):
DATABASE_URL=sqlite:///./securecode.db
# MySQL (as in the project requirements) - create the DB first, see ../database/schema.sql:
# DATABASE_URL=mysql+pymysql://securecode:securecode_pw@localhost:3306/securecode_ai

# ---- Security -------------------------------------------------------------
# Leave empty to auto-generate and store a random key in backend/.secret_key
SECRET_KEY=
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
# Registration can be switched off after you created your accounts
ALLOW_REGISTRATION=true
# Runs submitted code in a restricted subprocess (timeout + resource limits). Set false on shared servers.
ENABLE_CODE_EXECUTION=true
EXECUTION_TIMEOUT_SECONDS=5
RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=20

# ---- Optional external AI service (the platform works without it) --------
# If set, the AI module asks an LLM to write the explanations. Fixes are always validated by the SAST engine.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
